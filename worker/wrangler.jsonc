{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "albena-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static frontend built by the web/ team. Worker runs first so every asset
  // response also gets the security headers (and www -> apex redirect).
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // "auto-trailing-slash" is wrangler's name for the "auto" behaviour.
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },

  "routes": [
    { "pattern": "albena.ai", "custom_domain": true },
    { "pattern": "www.albena.ai", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "albena",
      "database_id": "70026d77-8cec-40a4-9340-e7f5113a0404",
      "migrations_dir": "migrations"
    }
  ],

  // ~5 requests / 60 s per key (we key on client IP + route) for POST endpoints.
  "ratelimits": [
    { "name": "POST_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],

  // Optional notifications; code is a no-op if the binding is missing/unverified.
  // Email notifications disabled for now (Omar 2026-10-09); re-add send_email binding after Email Routing is enabled.

  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFSUNDjjscz5JA0K",
    "NOTIFY_FROM": "notifications@albena.ai",
    "ENVIRONMENT": "production"
  },

  // Secrets (set with `wrangler secret put`, never in this file):
  //   TURNSTILE_SECRET_KEY  Turnstile widget secret
  //   IP_SALT               random string, salt for SHA-256 IP hashing
  //   ADMIN_AUD             Cloudflare Access application AUD tag
  //   TEAM_DOMAIN           e.g. yourteam.cloudflareaccess.com
  "env": {
    "staging": {
      "name": "albena-site-staging",
      "workers_dev": true,
      "routes": [],
      "d1_databases": [
        { "binding": "DB", "database_name": "albena", "database_id": "70026d77-8cec-40a4-9340-e7f5113a0404", "migrations_dir": "migrations" }
      ],
      "ratelimits": [
        { "name": "POST_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
      ],
      "vars": {
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFSUNDjjscz5JA0K",
        "NOTIFY_FROM": "notifications@albena.ai",
        "ENVIRONMENT": "staging",
        "EXTRA_TURNSTILE_HOSTS": "albena-site-staging.albena-site.workers.dev"
      }
    }
  }
}
