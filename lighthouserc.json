{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--no-sandbox", "onlyCategories": ["accessibility", "seo"] }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": { "categories:accessibility": ["error", { "minScore": 0.95 }] }
        },
        {
          "matchingUrlPattern": "^(?!.*/(404|admin)\\.html$).*",
          "assertions": { "categories:seo": ["error", { "minScore": 0.95 }] }
        }
      ]
    }
  }
}
