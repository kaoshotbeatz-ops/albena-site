---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you were looking for does not exist or has moved." noindex>
  <section class="nf">
    <svg class="orb" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
      <defs><radialGradient id="nfo" cx="40%" cy="35%" r="70%"><stop offset="0" stop-color="#c7c9ff" /><stop offset="0.5" stop-color="#7170ff" /><stop offset="1" stop-color="#3b3f94" /></radialGradient></defs>
      <circle cx="60" cy="60" r="56" fill="url(#nfo)" />
      <g stroke="#08090a" stroke-width="5" stroke-linecap="round"><path d="M36 60h0M48 60h0M60 60h0M72 60h0M84 60h0" /></g>
    </svg>
    <p class="code">404</p>
    <h1 class="h-section">Albena is listening, but that page is not here.</h1>
    <p class="msg">The page you were looking for does not exist or has moved.</p>
    <p class="row"><a class="btn btn-primary" href="/">Back to Albena</a> <a class="btn btn-ghost" href="/support">Contact support</a></p>
  </section>
</Base>

<style>
  .nf { min-height: 70vh; display: grid; place-content: center; justify-items: center; text-align: center; padding: 72px 20px; gap: 16px; background: radial-gradient(ellipse 50% 50% at 50% 30%, rgba(113, 112, 255, 0.2), transparent 70%); }
  .orb { width: 96px; height: 96px; filter: drop-shadow(0 0 40px rgba(113, 112, 255, 0.6)); animation: pulse 3s ease-in-out infinite; }
  .code { font-size: 13px; color: var(--acc-hi); letter-spacing: 0.2em; font-weight: 600; }
  h1 { max-width: 20ch; }
  .msg { color: var(--mut); }
  .row { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 8px; }
</style>
