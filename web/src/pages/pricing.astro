---
import Base from '../layouts/Base.astro';
const plans = [
  { id: 'byo', name: 'Bring Your Own', tag: 'Software license', blurb: 'Install Albena on a Mac or NVIDIA Linux machine you already own.', pts: ['Albena software license', 'Your Mac or NVIDIA Linux box', 'Self-guided setup'], edition: 'byo', cta: 'Reserve Bring Your Own' },
  { id: 'mac', name: 'Hub for Mac', tag: 'Apple silicon', blurb: 'A quiet, efficient Mac mini with Albena preinstalled. Ideal for homes.', pts: ['Albena Hub hardware, ready to plug in', 'Apple on-device intelligence and local models', '10-minute guided setup'], edition: 'mac', cta: 'Reserve Hub for Mac', featured: true },
  { id: 'nvidia', name: 'Hub for NVIDIA', tag: 'NVIDIA RTX', blurb: 'RTX-powered Hub for bigger models, vision and camera AI, and many users.', pts: ['Albena Hub hardware, ready to plug in', 'Bigger local models, vision and camera AI', 'Multi-user households and small businesses'], edition: 'nvidia', cta: 'Reserve Hub for NVIDIA' },
  { id: 'estate', name: 'Pro / Estate install', tag: 'Custom', blurb: 'We scope, install and tune Albena for your estate, property or business.', pts: ['Site survey and custom design', 'Installation and connector setup', 'Tailored to your rooms, people and systems'], edition: 'estate', cta: 'Request an install' },
];
const every = [
  ['Updates', 'Signed updates with automatic rollback.'],
  ['Connectors', 'The full connector catalog, plus bring-your-own for any REST API or MCP server.'],
  ['Approvals and audit', 'You approve changes, and every action is in the audit log.'],
  ['Memory control', 'See everything Albena remembers, and delete it any time.'],
];
const faq = [
  ['Do I need internet?', 'Everyday requests run locally, so Albena keeps working when the internet is down. Some connectors, such as email or cloud services, need a connection to reach their own systems.'],
  ['Can I use my own Mac?', 'Yes. Bring Your Own installs Albena on your Mac (Apple silicon) or an NVIDIA Linux machine.'],
  ['What if I already have a GPU?', 'Bring Your Own is built for that. Tell us your GPU on the waitlist and we will note it, so we can confirm what runs well before launch.'],
  ['What about cloud models?', 'Off unless you allow them, and then used at cost, only for tasks that need them. Albena tells you when she reaches for one.'],
  ['What about warranty and returns?', 'Details at launch.'],
  ['When can I buy?', 'We have not set dates or prices. Reserving costs nothing and commits you to nothing; we will email you first.'],
];
---
<Base title="Pricing" description="Albena plans: Bring Your Own software license, Hub for Mac, Hub for NVIDIA, and Pro / Estate install. Early access pricing is announced soon.">
  <div class="wrap page">
    <header class="top">
      <p class="eyebrow">Pricing</p>
      <h1 class="h-section">Plans for every home</h1>
      <p class="sub">Early access pricing is announced soon. Reserve your edition now, at no cost, and we will write before anything is final.</p>
    </header>

    <ul class="plans">
      {plans.map((p) => (
        <li class:list={['plan', { feat: p.featured }]}>
          <article aria-labelledby={`p-${p.id}`}>
            <div class="ph"><span class="chip indigo">{p.tag}</span>{p.featured && <span class="chip green">Most homes</span>}</div>
            <h2 id={`p-${p.id}`}>{p.name}</h2>
            <p class="price"><strong>Early access pricing</strong><span>Announced soon</span></p>
            <p class="blurb">{p.blurb}</p>
            <ul class="pts">{p.pts.map((x) => <li>{x}</li>)}</ul>
            <a class:list={['btn', p.featured ? 'btn-primary' : '']} href={`/waitlist?edition=${p.edition}`}>{p.cta}</a>
          </article>
        </li>
      ))}
    </ul>

    <section class="inc" aria-labelledby="inc-h">
      <h2 id="inc-h">Every plan includes</h2>
      <dl>
        {every.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <p class="cloud"><b>Optional cloud models.</b> Only if you allow them, and billed at cost.</p>
    </section>

    <section class="faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Questions</h2>
      <div class="qs">
        {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
      <p class="more">Not sure which fits? Read about the <a href="/hardware">hardware editions</a> or <a href="/support">contact support</a>.</p>
    </section>
  </div>
</Base>

<style>
  .page { padding-top: 72px; padding-bottom: 96px; }
  .top { max-width: 640px; margin-bottom: 44px; }
  .top h1 { font-size: clamp(36px, 6vw, 56px); }
  .plans { display: grid; gap: 14px; grid-template-columns: minmax(0, 1fr); }
  .plan article { height: 100%; display: flex; flex-direction: column; padding: 24px; border-radius: 18px; border: 1px solid var(--line-2); background: var(--panel); }
  .plan.feat article { border-color: rgba(113, 112, 255, 0.55); background: linear-gradient(180deg, rgba(113, 112, 255, 0.12), var(--panel) 55%); box-shadow: 0 0 60px -20px rgba(113, 112, 255, 0.5); }
  .ph { display: flex; gap: 8px; flex-wrap: wrap; min-height: 26px; }
  .plan h2 { font-size: 22px; letter-spacing: -0.03em; font-weight: 560; margin-top: 16px; }
  .price { margin-top: 10px; display: grid; }
  .price strong { font-size: 13px; font-weight: 500; color: var(--fg-2); }
  .price span { font-size: 22px; font-weight: 560; letter-spacing: -0.03em; }
  .blurb { margin-top: 12px; color: var(--mut); font-size: 14.5px; }
  .pts { margin: 18px 0 24px; display: grid; gap: 9px; flex: 1; }
  .pts li { position: relative; padding-left: 24px; font-size: 14px; color: var(--fg-2); }
  .pts li::before { content: ''; position: absolute; left: 3px; top: 5px; width: 5px; height: 9px; border: solid var(--green); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .plan .btn { white-space: normal; text-align: center; padding-top: 8px; padding-bottom: 8px; }

  .inc { margin-top: 72px; padding: 28px 24px; border: 1px solid var(--line); border-radius: 18px; background: rgba(255, 255, 255, 0.02); }
  .inc h2, .faq h2 { font-size: 26px; letter-spacing: -0.03em; font-weight: 560; }
  .inc dl { margin-top: 20px; display: grid; gap: 16px; }
  .inc dt { font-weight: 550; }
  .inc dd { color: var(--mut); font-size: 14.5px; margin-top: 2px; }
  .cloud { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line); color: var(--fg-2); font-size: 14.5px; }

  .faq { margin-top: 72px; max-width: 760px; }
  .qs { margin-top: 18px; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 52px; padding: 12px 0; font-weight: 520; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--mut); font-size: 20px; line-height: 1; flex: none; }
  details[open] summary::after { content: '\2212'; }
  details p { padding: 0 0 18px; color: var(--mut); max-width: 62ch; }
  .more { margin-top: 24px; color: var(--mut); font-size: 14.5px; }
  .more a { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }

  @media (min-width: 700px) { .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); } .inc dl { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1060px) { .plans { grid-template-columns: repeat(4, minmax(0, 1fr)); } .inc dl { grid-template-columns: repeat(4, 1fr); } .inc { padding: 32px; } }
</style>
