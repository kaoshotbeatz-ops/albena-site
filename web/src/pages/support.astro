---
import Base from '../layouts/Base.astro';
import Turnstile from '../components/Turnstile.astro';
const faqs: { cat: string; q: string; a: string }[] = [
  { cat: 'Getting started', q: 'What is Albena?', a: 'Albena is a voice-first AI assistant for your home and life, built by Omar Huertas LLC. You say “Hey Albena” and she can help with your home, calendar, mail and everyday tasks. She is local-first and asks for your approval before she acts.' },
  { cat: 'Getting started', q: 'When will Albena be available?', a: 'Albena is in early access and not yet generally available. We are inviting people from the waitlist in small groups. There is no fixed public launch date yet; we will email waitlist members before anything changes for them.' },
  { cat: 'Getting started', q: 'Which devices does Albena run on?', a: 'Early access is focused on Apple devices, with a home hub that runs on a computer in your home. Support for more platforms and smart-home brands is planned. Tell us what you use when you join the waitlist and it helps us prioritize.' },
  { cat: 'Getting started', q: 'What can Albena connect to?', a: 'Smart home, media, work and communication tools, cloud and infrastructure, and identity and IT systems, all available in early access. You can also add any REST API or MCP server. See the connectors page for the full list.' },
  { cat: 'Privacy and data', q: 'How does privacy work?', a: 'Albena processes as much as possible on hardware you control. This website sets no cookies and has no trackers, and we collect only what you send us through the waitlist and support forms. We never sell your data or use it for advertising. See the Privacy Policy for details.' },
  { cat: 'Privacy and data', q: 'How do I delete my data?', a: 'Email us from the address you signed up with and ask us to delete your data. We will remove your waitlist record and any early-access account data, and confirm when it is done. In the app you can also remove stored memories and disconnect calendar or mail at any time.' },
  { cat: 'Privacy and data', q: 'Does Albena make changes without asking?', a: 'No. Reads are instant, but any change is proposed to you first. High-risk actions also need a change record and your PIN, and everything is written to an audit log.' },
  { cat: 'Privacy and data', q: 'Why do the forms use a verification check?', a: 'The waitlist and support forms use Cloudflare Turnstile to block automated spam. It loads only when you reach a form, and it is the only third-party script on this site.' },
  { cat: 'Contact and security', q: 'How do I contact you?', a: 'Use the form on this page or email omar@dbaomarhuertasllc.com. For anything urgent about your account or data, put “Urgent” in the subject line.' },
  { cat: 'Contact and security', q: 'How do I report a security issue?', a: 'Email omar@dbaomarhuertasllc.com with details and steps to reproduce. Our security page and security.txt explain how we handle reports.' },
  { cat: 'Contact and security', q: 'I found an accessibility barrier on the site.', a: 'Please tell us the page and what went wrong using the form. We aim to reply within 2 business days and fix confirmed issues promptly.' },
];
const cats = [...new Set(faqs.map((f) => f.cat))];
---
<Base title="Support" description="Help center for Albena: search the FAQ, contact support, and see response times.">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Help center</p>
      <h1 class="h-display">How can we help?</h1>
      <div class="search js-only">
        <label for="faq-q" class="sr">Search the FAQ</label>
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="6" /><path d="m14 14 4 4" /></svg>
        <input id="faq-q" type="search" placeholder="Search questions, e.g. privacy, delete, devices" autocomplete="off" aria-controls="faq-list" />
      </div>
      <p class="sr" role="status" aria-live="polite" data-result></p>
    </div>
  </section>

  <div class="wrap grid">
    <div class="faq-col">
      <h2 class="sr">Frequently asked questions</h2>
      <div id="faq-list">
        {cats.map((c) => (
          <section class="faq-cat" data-cat aria-labelledby={`cat-${c.replace(/\W+/g, '-')}`}>
            <h3 id={`cat-${c.replace(/\W+/g, '-')}`}>{c}</h3>
            {faqs.filter((f) => f.cat === c).map((f) => (
              <details data-text={`${f.q} ${f.a}`.toLowerCase()}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        ))}
      </div>
      <p class="no-results" data-none hidden>No answers match your search. Try different words, or send us a message.</p>

      <section class="times" aria-labelledby="times-h">
        <h2 id="times-h">Response times</h2>
        <dl>
          <div><dt>Support email</dt><dd>Within 2 business days, usually sooner</dd></div>
          <div><dt>Privacy requests</dt><dd>Acknowledged in 5 business days, completed within 30 days</dd></div>
          <div><dt>Security reports</dt><dd>Acknowledged promptly</dd></div>
        </dl>
        <p>Albena is an early-access product built by a small team, so please bear with us during busy periods. See also the <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>
      </section>
    </div>

    <aside class="contact" id="contact" aria-labelledby="contact-h">
      <h2 id="contact-h">Contact support</h2>
      <p class="cl">A real person reads every message.</p>
      <div class="cwrap">
        <form class="form" action="/api/support" method="post" data-endpoint="/api/support" novalidate>
          <div class="field"><label for="s-name">Name</label>
            <input id="s-name" name="name" type="text" autocomplete="name" required data-validate aria-describedby="s-name-err" /><p class="err" id="s-name-err"></p></div>
          <div class="field"><label for="s-email">Email</label>
            <input id="s-email" name="email" type="email" inputmode="email" autocomplete="email" required data-validate aria-describedby="s-email-err" /><p class="err" id="s-email-err"></p></div>
          <div class="field"><label for="s-topic">Topic</label>
            <select id="s-topic" name="topic" required data-validate aria-describedby="s-topic-err">
              <option value="">Choose one</option><option value="waitlist">Waitlist or early access</option><option value="connectors">Connectors</option><option value="privacy">Privacy or data request</option><option value="bug">Bug or feedback</option><option value="accessibility">Accessibility</option><option value="other">Other</option>
            </select><p class="err" id="s-topic-err"></p></div>
          <div class="field"><label for="s-msg">How can we help?</label>
            <textarea id="s-msg" name="message" required data-validate data-min="10" aria-describedby="s-msg-err"></textarea><p class="err" id="s-msg-err"></p></div>
          <div class="field hp" aria-hidden="true"><label for="s-web">Website</label><input id="s-web" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
          <Turnstile action="support" />
          <button class="btn btn-primary" type="submit">Send message</button>
          <p class="form-status" data-status role="status" aria-live="polite"></p>
          <p class="form-note">We use what you send only to reply to you. See the <a href="/privacy">Privacy Policy</a>. Prefer email? <a href="mailto:omar@dbaomarhuertasllc.com?subject=Albena%20support">omar@dbaomarhuertasllc.com</a></p>
        </form>
        <div class="form-done" data-done hidden tabindex="-1">
          <h3>Message sent.</h3>
          <p>Thank you. We will reply within 2 business days.</p>
        </div>
      </div>
    </aside>
  </div>
</Base>

<style>
  .hero { padding: 72px 0 40px; text-align: center; background: radial-gradient(ellipse 60% 100% at 50% -20%, rgba(113, 112, 255, 0.2), transparent 70%); }
  h1 { font-size: clamp(40px, 8vw, 68px); margin-bottom: 28px; }
  .search { position: relative; max-width: 560px; margin: 0 auto; }
  .search svg { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; stroke: var(--mut); stroke-width: 1.6; fill: none; stroke-linecap: round; pointer-events: none; }
  .search input { width: 100%; min-height: 54px; padding: 0 20px 0 48px; border-radius: 999px; border: 1px solid var(--line-2); background: rgba(255, 255, 255, 0.04); font-size: 16px; }
  .search input::placeholder { color: #7b808a; }
  .search input:focus-visible { outline: 0; border-color: var(--acc-hi); box-shadow: 0 0 0 4px rgba(113, 112, 255, 0.22); }
  .js-only { display: none; }
  :global(.js) .js-only { display: block; }

  .grid { display: grid; gap: 48px; padding-top: 32px; padding-bottom: 96px; }
  @media (min-width: 960px) { .grid { grid-template-columns: 1.5fr 1fr; gap: 64px; align-items: start; } .contact { position: sticky; top: 88px; } }
  .faq-cat { margin-bottom: 36px; }
  .faq-cat h3 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--acc-hi); font-weight: 600; margin-bottom: 4px; }
  .faq-cat[hidden] { display: none; }
  details { border-bottom: 1px solid var(--line); padding: 4px 0; }
  details[hidden] { display: none; }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 0; min-height: 48px; font-weight: 520; font-size: 15.5px; border-radius: 6px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--mut); font-size: 20px; line-height: 1; flex: none; }
  details[open] summary::after { content: '\2212'; }
  details p { padding: 0 0 16px; color: var(--mut); font-size: 15px; max-width: 62ch; }
  .no-results { padding: 28px; text-align: center; color: var(--mut); border: 1px dashed var(--line-2); border-radius: 14px; }

  .times { margin-top: 24px; padding: 24px; border: 1px solid var(--line); border-radius: 16px; background: var(--panel); }
  .times h2 { font-size: 18px; margin-bottom: 12px; }
  .times dl div { display: grid; gap: 2px; padding: 10px 0; border-top: 1px solid var(--line); }
  .times dt { font-weight: 520; font-size: 14px; }
  .times dd { color: var(--mut); font-size: 14px; }
  .times > p { margin-top: 12px; color: var(--mut); font-size: 13.5px; }
  .times a { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }

  .contact { padding: 24px; border: 1px solid var(--line-2); border-radius: 18px; background: linear-gradient(180deg, #131417, #0e0f11); box-shadow: 0 30px 80px -40px rgba(113, 112, 255, 0.5); }
  .contact h2 { font-size: 22px; letter-spacing: -0.025em; }
  .cl { color: var(--mut); margin: 4px 0 20px; font-size: 14.5px; }
</style>

<script>
  import '../scripts/forms';
  const input = document.getElementById('faq-q') as HTMLInputElement | null;
  const items = [...document.querySelectorAll<HTMLDetailsElement>('#faq-list details')];
  const cats = [...document.querySelectorAll<HTMLElement>('[data-cat]')];
  const none = document.querySelector<HTMLElement>('[data-none]');
  const result = document.querySelector<HTMLElement>('[data-result]');
  input?.addEventListener('input', () => {
    const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let n = 0;
    items.forEach((d) => {
      const ok = terms.every((t) => d.dataset.text!.includes(t));
      d.hidden = !ok;
      if (terms.length) d.open = ok && terms.length > 0 && items.filter((x) => !x.hidden).length <= 3;
      if (ok) n++;
    });
    cats.forEach((c) => { c.hidden = ![...c.querySelectorAll('details')].some((d) => !d.hidden); });
    if (none) none.hidden = n !== 0;
    if (result) result.textContent = terms.length ? `${n} ${n === 1 ? 'answer' : 'answers'} found` : '';
  });
</script>
