---
import Turnstile from './Turnstile.astro';
interface Props { id?: string }
const { id = 'wl' } = Astro.props;
---
<div class="wl">
  <form class="form" action="/api/waitlist" method="post" data-endpoint="/api/waitlist" novalidate>
    <div class="field">
      <label for={`${id}-email`}>Email address</label>
      <input id={`${id}-email`} name="email" type="email" inputmode="email" autocomplete="email" placeholder="you@example.com" required data-validate aria-describedby={`${id}-email-err`} />
      <p class="err" id={`${id}-email-err`}></p>
    </div>
    <div class="field">
      <label for={`${id}-interest`}>Interested in <span class="opt">(optional)</span></label>
      <select id={`${id}-interest`} name="interest" data-interest>
        <option value="">Not sure yet</option>
        <option value="mac">Albena Hub for Mac</option>
        <option value="nvidia">Albena Hub for NVIDIA</option>
        <option value="byo">Bring your own hardware</option>
        <option value="estate">Pro / Estate install</option>
      </select>
    </div>
    <div class="field hp" aria-hidden="true">
      <label for={`${id}-web`}>Website</label>
      <input id={`${id}-web`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <Turnstile action="waitlist" />
    <button class="btn btn-primary" type="submit">Join the waitlist</button>
    <p class="form-status" data-status role="status" aria-live="polite"></p>
    <p class="form-note">We use your email only for early-access news. No spam, and you can leave any time. See the <a href="/privacy">Privacy Policy</a>.</p>
  </form>
  <div class="form-done" data-done hidden tabindex="-1">
    <h3>You are on the list.</h3>
    <p>We will email you when early access opens up for you.</p>
  </div>
</div>
<script>
  import '../scripts/forms';
</script>
