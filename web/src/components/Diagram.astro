---
export interface DNode { x: number; y: number; w: number; h: number; t?: string; s?: string | string[]; kind?: 'plain' | 'accent' | 'dashed' | 'group' | 'ok' | 'warn' }
export interface DEdge { d: string; dashed?: boolean; arrow?: boolean }
interface Props { w: number; h: number; nodes: DNode[]; edges: DEdge[]; label: string; desc: string; id: string; variant: 'wide' | 'narrow' }
const { w, h, nodes, edges, label, desc, id, variant } = Astro.props;
const lines = (s?: string | string[]) => (s === undefined ? [] : Array.isArray(s) ? s : [s]);
---
<svg class={`dg ${variant}`} viewBox={`0 0 ${w} ${h}`} role="img" aria-labelledby={`${id}-t ${id}-d`} focusable="false">
  <title id={`${id}-t`}>{label}</title>
  <desc id={`${id}-d`}>{desc}</desc>
  <defs>
    <marker id={`${id}-a`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M1 1 9 5 1 9z" class="ah" /></marker>
  </defs>
  {nodes.filter((n) => n.kind === 'group').map((n) => (
    <g><rect class="n group" x={n.x} y={n.y} width={n.w} height={n.h} rx="16" /><text class="gl" x={n.x + 16} y={n.y + 22}>{n.t}</text></g>
  ))}
  {edges.map((e) => <path class={`e${e.dashed ? ' dash' : ''}`} d={e.d} marker-end={e.arrow === false ? undefined : `url(#${id}-a)`} />)}
  {nodes.filter((n) => n.kind !== 'group').map((n) => {
    const sub = lines(n.s);
    const total = 1 + sub.length;
    const startY = n.y + n.h / 2 - ((total - 1) * 17) / 2 + 5;
    return (
      <g>
        <rect class={`n ${n.kind ?? 'plain'}`} x={n.x} y={n.y} width={n.w} height={n.h} rx="12" />
        <text class="nt" x={n.x + 16} y={startY}>{n.t}</text>
        {sub.map((l, i) => <text class="ns" x={n.x + 16} y={startY + 18 * (i + 1) - 1}>{l}</text>)}
      </g>
    );
  })}
</svg>

<style is:global>
  .dg { width: 100%; height: auto; max-width: 100%; }
  .dg .n { fill: #121316; stroke: rgba(255, 255, 255, 0.16); stroke-width: 1; }
  .dg .n.group { fill: rgba(113, 112, 255, 0.05); stroke: rgba(113, 112, 255, 0.4); stroke-dasharray: none; }
  .dg .n.accent { fill: rgba(113, 112, 255, 0.16); stroke: #7170ff; }
  .dg .n.ok { fill: rgba(76, 183, 130, 0.1); stroke: rgba(76, 183, 130, 0.6); }
  .dg .n.warn { fill: rgba(242, 201, 76, 0.08); stroke: rgba(242, 201, 76, 0.55); }
  .dg .n.dashed { stroke-dasharray: 5 4; fill: transparent; }
  .dg .nt { fill: #f7f8f8; font: 600 14px 'Inter Variable', Inter, system-ui, sans-serif; }
  .dg .ns { fill: #a3a8b1; font: 450 12px 'Inter Variable', Inter, system-ui, sans-serif; }
  .dg .gl { fill: #b6b8ff; font: 600 12px 'Inter Variable', Inter, system-ui, sans-serif; letter-spacing: 0.04em; text-transform: uppercase; }
  .dg .e { fill: none; stroke: #8a8f98; stroke-width: 1.5; }
  .dg .e.dash { stroke-dasharray: 5 4; }
  .dg .ah { fill: #8a8f98; }
  .dg.narrow { display: block; max-width: 420px; margin: 0 auto; }
  .dg.wide { display: none; }
  @media (min-width: 760px) { .dg.wide { display: block; } .dg.narrow { display: none; } }
</style>
