---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { SITE, OG_IMAGE, OG_IMAGE_ALT, organization, website, software } from '../data/seo';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogTitle?: string;
  ogImageAlt?: string;
  /** Extra schema.org nodes for this page (added to the page's @graph). */
  schema?: Record<string, unknown>[];
  /** Name used for this page in the BreadcrumbList. Defaults to title. */
  crumb?: string;
}
const { title, description, noindex = false, ogTitle, ogImageAlt = OG_IMAGE_ALT, schema = [], crumb } = Astro.props;
// build.format is "file", so Astro.url.pathname ends in ".html"; canonical URLs never do.
const path = Astro.url.pathname.replace(/(^|\/)index\.html$/, '$1').replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonical = path === '/' ? `${SITE}/` : `${SITE}${path}`;
const fullTitle = path === '/' ? title : `${title} | Albena`;

const crumbs = path === '/' ? [] : [
  { name: 'Home', url: `${SITE}/` },
  ...(path.startsWith('/trust/') ? [{ name: 'Trust center', url: `${SITE}/trust` }] : []),
  { name: crumb ?? title, url: canonical },
];
const graph: Record<string, unknown>[] = [
  organization,
  website,
  ...(path === '/' ? [software] : []),
  ...(crumbs.length
    ? [{ '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })) }]
    : []),
  ...schema,
];
// JSON-LD is data, not script: browsers never execute it, so script-src does not apply.
const jsonLd = noindex ? '' : JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#08090a" />
  <meta name="color-scheme" content="dark" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  {noindex
    ? <meta name="robots" content="noindex" />
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="Albena summary for AI assistants (llms.txt)" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Albena" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={ogTitle ?? fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle ?? fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={OG_IMAGE} />
  <meta name="twitter:image:alt" content={ogImageAlt} />
  {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Nav />
  <main id="main" tabindex="-1"><slot /></main>
  <Footer />
  <script>
    import '../scripts/site';
  </script>
</body>
</html>
