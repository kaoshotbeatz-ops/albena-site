---
import Base from './Base.astro';
interface Props { title: string; description: string; alt: string; eyebrow?: string; heading: string; lede: string; wide?: boolean }
const { title, description, alt, eyebrow, heading, lede } = Astro.props;
---
<Base title={title} description={description} lang="es" alt={alt}>
  <div class="wrap es-doc">
    <p class="es-note" role="note"><strong>Traducción en revisión.</strong> Esta página es un borrador de traducción automática que aún no ha sido revisado por una persona. Si hay diferencias, prevalece la <a href={alt} hreflang="en" lang="en">versión en inglés</a>.</p>
    <header class="es-head">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="h-display">{heading}</h1>
      <p class="lead">{lede}</p>
    </header>
    <slot />
  </div>
</Base>

<style is:global>
  .es-doc { padding-top: 56px; padding-bottom: 96px; max-width: 820px; }
  .es-note { border: 1px solid var(--line-2); background: var(--panel); border-radius: 12px; padding: 12px 16px; font-size: 14px; color: var(--fg-2); margin-bottom: 36px; }
  .es-note a, .es-doc section a:not(.btn) { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }
  .es-head { margin-bottom: 36px; }
  .es-head h1 { font-size: clamp(34px, 6vw, 56px); line-height: 1.08; letter-spacing: -0.035em; margin-bottom: 16px; }
  .es-doc section { margin-top: 36px; }
  .es-doc h2 { font-size: 22px; line-height: 1.3; letter-spacing: -0.015em; font-weight: 600; margin-bottom: 10px; }
  .es-doc p, .es-doc li { color: var(--mut); font-size: 16px; line-height: 1.7; }
  .es-doc p + p, .es-doc p + ul { margin-top: 12px; }
  .es-doc ul.pl { list-style: disc; padding-left: 22px; margin-top: 10px; }
  .es-doc ul.pl li { margin-top: 6px; }
  .es-doc strong { color: var(--fg); font-weight: 500; }
  .es-cards { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); margin-top: 16px; }
  .es-card { border: 1px solid var(--line-2); border-radius: 14px; background: var(--panel); padding: 16px; }
  .es-card h3 { font-size: 16px; font-weight: 560; color: var(--fg); margin-bottom: 6px; }
  .es-card p { font-size: 14.5px; }
  .es-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
</style>
