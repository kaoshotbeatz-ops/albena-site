---
import Logo from '../components/Logo.astro';
import '../styles/global.css';
import '../styles/admin.css';

interface Props { title: string; section: 'overview' | 'waitlist' | 'tickets' | 'audit' | 'system'; lead?: string }
const { title, section, lead } = Astro.props;
const items = [
  { id: 'overview', href: '/admin', label: 'Overview', d: 'M3 10.5 10 4l7 6.5V16a1 1 0 0 1-1 1h-3.5v-4.5h-5V17H4a1 1 0 0 1-1-1z' },
  { id: 'waitlist', href: '/admin/waitlist', label: 'Waitlist', d: 'M3 5h14M3 10h14M3 15h9' },
  { id: 'tickets', href: '/admin/tickets', label: 'Tickets', d: 'M3 6.5A1.5 1.5 0 0 1 4.5 5h11A1.5 1.5 0 0 1 17 6.5v1.2a2 2 0 0 0 0 4.6v1.2a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 13.5v-1.2a2 2 0 0 0 0-4.6z' },
  { id: 'audit', href: '/admin/audit', label: 'Audit log', d: 'M10 3 4 5.5v4.2c0 3.6 2.4 6.2 6 7.3 3.6-1.1 6-3.7 6-7.3V5.5zM7.5 10l2 2 3.5-3.8' },
  { id: 'system', href: '/admin/system', label: 'System', d: 'M4 6h12M4 10h12M4 14h12M7 4v4M13 8v4M9 12v4' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Albena admin</title>
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <meta name="description" content="Albena owner admin." />
  <meta name="theme-color" content="#08090a" />
  <meta name="color-scheme" content="dark" />
  <meta name="referrer" content="same-origin" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="admin">
  <a class="skip" href="#main">Skip to content</a>
  <div class="shell">
    <aside class="side" data-side>
      <div class="side-top">
        <a class="brand" href="/admin" aria-label="Albena admin home"><Logo size={22} id="adm" /><span>Albena</span><span class="env">admin</span></a>
        <button class="side-toggle" type="button" aria-expanded="false" aria-controls="side-nav" aria-label="Menu" data-side-toggle>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" /></svg>
        </button>
      </div>
      <nav id="side-nav" class="side-nav" aria-label="Admin" data-side-nav>
        <ul>
          {items.map((i) => (
            <li><a href={i.href} data-admin-link aria-current={i.id === section ? 'page' : undefined}>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d={i.d} /></svg>{i.label}
            </a></li>
          ))}
        </ul>
        <p class="side-foot"><a href="/trust">Trust center</a><span data-mock-flag hidden class="chip amber">Mock data</span></p>
      </nav>
    </aside>
    <main id="main" tabindex="-1" class="content">
      <div id="session-banner" class="banner is-error" role="alert" hidden>Session expired — reload to sign in. <button class="btn btn-sm" type="button" data-reload>Reload</button></div>
      <header class="page-head">
        <div>
          <h1>{title}</h1>
          {lead && <p class="page-lead">{lead}</p>}
        </div>
        <div class="page-actions"><slot name="actions" /></div>
      </header>
      <slot />
      <p id="toast" class="toast" role="status" aria-live="polite"></p>
    </main>
  </div>
  <script>
    import '../scripts/admin/shell';
  </script>
</body>
</html>
