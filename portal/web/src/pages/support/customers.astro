---
import Staff from '../../layouts/Staff.astro';
---
<Staff title="Customers" lead="Create customers, set plans by hand and open the portal exactly as a customer sees it (read only, 30 minutes, every view is logged)." section="customers">
  <a slot="actions" class="btn" href="/support/invite">Invite people</a>
  <details class="panel" id="new">
    <summary>New customer without an invite</summary>
    <div class="panel-body" id="new-body"></div>
  </details>
  <div class="toolbar" role="search">
    <div class="grow"><label class="sr" for="q">Search customers</label><input class="input" id="q" type="search" placeholder="Search by email, id or plan" autocomplete="off" /></div>
    <p class="mut" id="count" role="status" aria-live="polite"></p>
  </div>
  <div id="root" aria-busy="true"><p class="loading">Loading…</p></div>
  <script>import '../../scripts/support-customers';</script>
</Staff>
