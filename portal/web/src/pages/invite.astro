---
import Auth from '../layouts/Auth.astro';
import Turnstile from '../components/Turnstile.astro';
---
<Auth title="Accept your invitation">
  <div>
    <h1>You're invited to Albena</h1>
    <p class="mut mt-s">Confirm the email address this invitation was sent to. We will then email you a sign-in link and code.</p>
  </div>
  <form id="invite-form" class="stack lg" novalidate>
    <div class="field">
      <label for="email">Your email address</label>
      <input class="input lg" id="email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="email-err" placeholder="you@example.com" />
      <p class="err" id="email-err"></p>
    </div>
    <Turnstile action="magic_login" />
    <button class="btn btn-primary btn-lg" id="accept" type="submit">Continue</button>
    <p class="form-status" id="status" role="status" aria-live="polite"></p>
  </form>
  <p class="mut small">Already have an account? <a class="tlink" href="/login">Sign in</a>.</p>
  <script>import '../scripts/invite';</script>
</Auth>
