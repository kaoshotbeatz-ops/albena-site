---
import App from '../layouts/App.astro';
---
<App title="Support" section="support" lead="Help with your Hub, plan or account.">
  <div class="grid-2">
    <section class="panel">
      <header><h2>Get help</h2></header>
      <div class="panel-body">
        <p class="mut">Open a ticket and we’ll reply by email. Include your Hub name and version if it’s about a device.</p>
        <p><a class="btn btn-primary" href="https://albena.ai/support" target="_blank" rel="noopener noreferrer">Contact support<span class="sr"> (opens albena.ai in a new tab)</span></a></p>
      </div>
    </section>
    <section class="panel">
      <header><h2>Help docs</h2></header>
      <div class="panel-body">
        <ul class="links-list">
          <li><a href="https://albena.ai/support#pairing" target="_blank" rel="noopener noreferrer">Pairing a Hub<span class="sr"> (opens in a new tab)</span></a></li>
          <li><a href="https://albena.ai/support#billing" target="_blank" rel="noopener noreferrer">Plans and billing<span class="sr"> (opens in a new tab)</span></a></li>
          <li><a href="https://albena.ai/support#passkeys" target="_blank" rel="noopener noreferrer">Passkeys and signing in<span class="sr"> (opens in a new tab)</span></a></li>
          <li><a href="https://albena.ai/security" target="_blank" rel="noopener noreferrer">How we protect your data<span class="sr"> (opens in a new tab)</span></a></li>
        </ul>
      </div>
    </section>
  </div>
  <script>import '../scripts/page';</script>
</App>
