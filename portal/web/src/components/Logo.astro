---
// Listening-orb mark (from brand/logo-2-mark.svg), gradient-filled.
interface Props { size?: number; id?: string }
const { size = 20, id = 'orb' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-g`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#a5a8ff" />
      <stop offset="1" stop-color="#5e6ad2" />
    </linearGradient>
    <mask id={`${id}-m`}>
      <rect width="32" height="32" fill="#fff" />
      <g stroke="#000" stroke-width="2.4" stroke-linecap="round">
        <path d="M9.5 14v4" /><path d="M13.25 11v10" /><path d="M17 8.5v15" /><path d="M20.75 12v8" /><path d="M24.5 14.5v3" />
      </g>
    </mask>
  </defs>
  <circle cx="16" cy="16" r="14" fill={`url(#${id}-g)`} mask={`url(#${id}-m)`} />
</svg>
