---
// Public, signed-out reading page (accessibility statement). No auth script, no account data.
import Logo from '../components/Logo.astro';
import '../styles/portal.css';
interface Props { title: string; lede?: string; meta?: string }
const { title, lede, meta } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Albena account</title>
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <meta name="theme-color" content="#08090a" />
  <meta name="color-scheme" content="dark" />
  <meta name="referrer" content="same-origin" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="doc-page">
  <a class="skip" href="#main">Skip to content</a>
  <header class="doc-top"><a class="brand" href="https://albena.ai" aria-label="Albena home"><Logo size={22} id="dc" /><span>Albena</span></a><nav aria-label="Account"><a href="/login">Sign in</a> <a href="/support">Support</a></nav></header>
  <main id="main" tabindex="-1" class="doc-main">
    <h1>{title}</h1>
    {meta && <p class="doc-meta">{meta}</p>}
    {lede && <p class="doc-lede">{lede}</p>}
    <slot />
  </main>
</body>
</html>
