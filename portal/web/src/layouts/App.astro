---
import Logo from '../components/Logo.astro';
import '../styles/portal.css';

interface Props { title: string; section: string; lead?: string }
const { title, section, lead } = Astro.props;
const I = {
  home: 'M3 10.5 10 4l7 6.5V16a1 1 0 0 1-1 1h-3.5v-4.5h-5V17H4a1 1 0 0 1-1-1z',
  hub: 'M4 13V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM8 17h4',
  dl: 'M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 15.5h12',
  plug: 'M7.5 3v4M12.5 3v4M5.5 7h9v2.5a4.5 4.5 0 0 1-9 0zM10 14v3',
  card: 'M3 6.5A1.5 1.5 0 0 1 4.5 5h11A1.5 1.5 0 0 1 17 6.5v7a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 13.5zM3 8.5h14',
  box: 'M10 3 16.5 6.5v7L10 17l-6.5-3.5v-7zM3.5 6.5 10 10l6.5-3.5M10 10v7',
  people: 'M7.5 9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM2.5 16c0-2.5 2.2-4 5-4s5 1.5 5 4M13.5 9.2a2.2 2.2 0 1 0 0-4.4M14.5 12.2c1.7.4 3 1.6 3 3.8',
  gift: 'M3.5 8h13v3h-13zM4.5 11v5.5h11V11M10 8v8.5M10 8C8 8 6.5 7 6.5 5.7 6.5 4.6 7.4 4 8.3 4 9.3 4 10 5.5 10 8zM10 8c2 0 3.5-1 3.5-2.3 0-1.1-.9-1.7-1.8-1.7C10.7 4 10 5.5 10 8z',
  shield: 'M10 3 4 5.5v4.2c0 3.6 2.4 6.2 6 7.3 3.6-1.1 6-3.7 6-7.3V5.5zM7.5 10l2 2 3.5-3.8',
  lock: 'M5.5 9V6.5a4.5 4.5 0 0 1 9 0V9M4.5 9h11v7.5h-11z',
  help: 'M10 17a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM7.8 8a2.3 2.3 0 1 1 3.4 2c-.8.5-1.2.9-1.2 1.8M10 14.2v.1',
};
const groups = [
  { label: '', items: [{ id: 'dashboard', href: '/', label: 'Dashboard', d: I.home }] },
  { label: 'Hubs', items: [
    { id: 'hubs', href: '/hubs', label: 'Hubs', d: I.hub },
    { id: 'downloads', href: '/downloads', label: 'Downloads', d: I.dl },
    { id: 'connectors', href: '/connectors', label: 'Connectors', d: I.plug },
  ] },
  { label: 'Account', items: [
    { id: 'billing', href: '/billing', label: 'Billing', d: I.card },
    { id: 'orders', href: '/orders', label: 'Orders', d: I.box },
    { id: 'household', href: '/household', label: 'Household', d: I.people },
    { id: 'perks', href: '/perks', label: 'Perks', d: I.gift },
  ] },
  { label: 'Settings', items: [
    { id: 'security', href: '/security', label: 'Security', d: I.shield },
    { id: 'privacy', href: '/privacy', label: 'Privacy & data', d: I.lock },
    { id: 'support', href: '/support', label: 'Support', d: I.help },
  ] },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Albena account</title>
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <meta name="description" content="Manage your Albena plan, Hubs and account." />
  <meta name="theme-color" content="#08090a" />
  <meta name="color-scheme" content="dark" />
  <meta name="referrer" content="same-origin" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="app">
  <a class="skip" href="#main">Skip to content</a>
  <header class="topbar">
    <button class="icon-btn" type="button" aria-expanded="false" aria-controls="side" aria-label="Open menu" data-side-toggle>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" /></svg>
    </button>
    <a class="brand" href="/" aria-label="Albena account home"><Logo size={22} id="tb" /><span>Albena</span></a>
  </header>
  <div class="scrim" data-scrim hidden></div>
  <div class="shell">
    <aside id="side" class="side" aria-label="Sidebar" data-side>
      <div class="side-top">
        <a class="brand" href="/" aria-label="Albena account home"><Logo size={22} id="sd" /><span>Albena</span></a>
        <button class="icon-btn close-btn" type="button" aria-label="Close menu" data-side-close><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" /></svg></button>
      </div>
      <div class="ws">
        <button class="ws-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="ws-menu" data-ws-btn>
          <span class="ws-ico" aria-hidden="true">M</span>
          <span class="ws-name" data-ws-name>My home</span>
          <svg viewBox="0 0 20 20" aria-hidden="true" class="chev"><path d="m6 8 4 4 4-4" /></svg>
        </button>
        <div id="ws-menu" class="ws-menu" hidden data-ws-menu>
          <p class="ws-lbl">Workspace</p>
          <p class="ws-cur"><span data-ws-name2>My home</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 10.5 3.2 3.2L15 7" /></svg></p>
          <p class="ws-lbl" data-who>Signed in</p>
          <button class="ws-item" type="button" data-logout>Sign out</button>
        </div>
      </div>
      <button class="search-btn" type="button" data-search-open aria-haspopup="dialog">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12zM13.5 13.5 17 17" /></svg>
        <span>Search</span><kbd class="kbd" aria-hidden="true">⌘K</kbd>
      </button>
      <nav class="side-nav" aria-label="Main">
        {groups.map((g) => (
          <div class="grp">
            {g.label && <p class="grp-l" id={`g-${g.label}`}>{g.label}</p>}
            <ul aria-labelledby={g.label ? `g-${g.label}` : undefined}>
              {g.items.map((i) => (
                <li><a href={i.href} data-nav aria-current={i.id === section ? 'page' : undefined}>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d={i.d} /></svg>{i.label}
                </a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
      <p class="side-foot"><a href="https://albena.ai/trust">Trust center</a><span data-mock-flag hidden class="chip amber">Mock data</span></p>
    </aside>
    <main id="main" tabindex="-1" class="content">
      <header class="page-head">
        <div>
          <h1>{title}</h1>
          {lead && <p class="page-lead">{lead}</p>}
        </div>
        <div class="page-actions"><slot name="actions" /></div>
      </header>
      <slot />
      <p id="toast" class="toast" role="status" aria-live="polite"></p>
    </main>
  </div>
  <dialog class="palette" aria-label="Search" data-palette>
    <label class="sr" for="pal-in">Search pages</label>
    <input id="pal-in" class="pal-in" type="search" placeholder="Search pages…" autocomplete="off" role="combobox" aria-expanded="true" aria-controls="pal-list" aria-autocomplete="list" />
    <ul id="pal-list" class="pal-list" role="listbox" aria-label="Pages"></ul>
  </dialog>
  <slot name="end" />
</body>
</html>
