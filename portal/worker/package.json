{
  "name": "albena-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply albena_portal --local",
    "predeploy": "node ../scripts/check-portal-build.mjs deploy",
    "deploy": "wrangler deploy",
    "deploy:staging": "node ../scripts/check-portal-build.mjs deploy && wrangler deploy --env staging",
    "migrate:staging": "wrangler d1 migrations apply albena_portal_staging --env staging --remote",
    "migrate:prod": "wrangler d1 migrations apply albena_portal --remote"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.3",
    "hono": "4.13.13",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261009.1",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  }
}
